# Firebase Configuration (Optional - platform auto-falls back to prototype mode if not provided)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Google Gemini API Key (Optional - platform has intelligent local market explanation fallback)
VITE_GEMINI_API_KEY=your_gemini_api_key

# Google Maps Platform API Key (Optional - platform includes interactive canvas/SVG fallback route map)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_key
